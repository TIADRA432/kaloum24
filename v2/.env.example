# Documentation only: never commit credentials. Not loaded automatically.
DATABASE_URL=postgresql://postgres:REPLACE_URL_ENCODED_PASSWORD@db.qlkeieckyhvpjmyzuwjk.supabase.co:5432/postgres
# For IPv4, copy the Session pooler URL from the existing project's Connect panel.
# User: postgres.qlkeieckyhvpjmyzuwjk ; port: 5432 ; do not guess the pooler hostname.
DATABASE_SSLMODE=require
# Temporary Access alternative: enable and authorize your user in Supabase first.
# The token replaces the URL password in memory; pooler jit=on is added safely.
DATABASE_AUTH_MODE=password
# DATABASE_AUTH_MODE=access_token
# SUPABASE_ACCESS_TOKEN=REPLACE_WITH_PERSONAL_ACCESS_TOKEN
# For certificate/hostname verification, use verify-full and the Supabase CA file:
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=/absolute/path/to/prod-supabase.cer
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
ALLOWED_HOSTS=localhost
DJANGO_SETTINGS_MODULE=kaloum24_v2.settings.supabase
