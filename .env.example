# Copie ce fichier en ".env" et adapte les valeurs.
# Génère une clé : python -c "import secrets; print(secrets.token_hex(32))"

# ---------- Identité du site ----------
SITE_NAME=Kaloum24
SITE_TAGLINE=L'actualité en continu
SITE_DESCRIPTION=Toute l'actualité en continu : politique, économie, société, sport et culture.
# IMPORTANT : l'URL publique réelle. Elle sert aux aperçus de partage WhatsApp,
# au flux RSS et au sitemap. Une valeur erronée casse les partages sociaux.
SITE_URL=http://127.0.0.1:5000

SECRET_KEY=remplace-moi-par-une-longue-chaine-aleatoire

# ---------- Réseaux sociaux (vide = lien masqué) ----------
SOCIAL_X=
SOCIAL_WHATSAPP_CHANNEL=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=

# ---------- Météo (Open-Meteo : gratuit, aucune clé requise) ----------
WEATHER_ENABLED=1
WEATHER_CITY=Conakry
WEATHER_LAT=9.6412
WEATHER_LON=-13.5784
WEATHER_TIMEZONE=Africa/Conakry

# ---------- Lecture audio des articles ----------
TTS_ENABLED=1
TTS_LANG=fr-FR

# ---------- Publication par WhatsApp (correspondants) ----------
# Laisser WHATSAPP_ENABLED=0 tant que la configuration Meta n'est pas prête :
# le webhook répond 404 par défaut, sans rien exposer. Voir le README §5.
WHATSAPP_ENABLED=0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Indicatif pays (sans +) pour compléter les numéros tapés au format local.
# 224 = Guinée. À adapter pour un déploiement dans un autre pays.
WHATSAPP_COUNTRY_CODE=224
# Slug de la rubrique assignée par défaut aux articles créés par WhatsApp.
WHATSAPP_DEFAULT_CATEGORY=societe

# ---------- Production ----------
# Passe à "production" pour activer les protections strictes : cookies
# réservés à HTTPS, et refus de démarrer si la configuration est dangereuse
# (clé secrète par défaut, SITE_URL locale, webhook non signé).
ENV=development

# Nombre de proxys devant l'application. Derrière Nginx : 1.
# Si tu laisses 0 derrière un proxy, la limitation de débit verra toutes les
# requêtes venir du proxy et bloquera tous les visiteurs d'un coup.
PROXY_COUNT=0

SECURITY_HEADERS_ENABLED=1
# HSTS force les navigateurs à n'utiliser que HTTPS. À n'activer QU'APRÈS
# avoir un certificat valide : sinon le site devient inaccessible aux
# visiteurs déjà venus, pour toute la durée annoncée.
HSTS_ENABLED=0
HSTS_MAX_AGE=31536000

# ---------- Journalisation ----------
# Indispensable en production : sans fichiers de journaux, les erreurs sont
# perdues et l'on ne peut pas comprendre après coup ce qui s'est passé.
LOG_TO_FILE=0
LOG_LEVEL=INFO

# ---------- Limitation de débit ----------
# Protège connexion, inscription, commentaires et réinitialisation de mot de
# passe contre le bourrage et le spam. Mettre 0 pour désactiver (déconseillé
# en production).
RATELIMIT_ENABLED=1
# En mémoire par défaut : correct pour un seul processus. Avec plusieurs
# workers gunicorn, chacun aurait son propre compteur — utilise alors Redis,
# ex. redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=10 per 5 minutes
RATELIMIT_REGISTER=5 per hour
RATELIMIT_COMMENT=10 per 10 minutes

# ---------- Modération des commentaires ----------
# 0 = pré-modération (par défaut, le plus prudent) : tout commentaire attend
# une validation humaine. 1 = post-modération : un commentaire qui passe les
# filtres automatiques ci-dessous s'affiche immédiatement.
COMMENT_AUTO_APPROVE=0
COMMENT_MAX_LIENS=1
COMMENT_SPAM_KEYWORDS=viagra, casino, crypto gratuit, gagner de l'argent, cliquez ici, xxx, rencontre adulte, pret immediat, forex
RATELIMIT_PASSWORD_RESET=5 per hour
RATELIMIT_WEBHOOK=120 per minute

# ---------- E-mail (réinitialisation de mot de passe) ----------
# Si MAIL_SERVER est vide, les e-mails s'affichent dans la console du serveur
# au lieu d'être envoyés — pratique en développement.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@example.com

# ---------- Stripe (vide = page d'abonnement en mode informatif) ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_LABEL=15 000 GNF / mois

# ---------- Agrégation de sources (voir PLAN_AGREGATEUR.md) ----------
# Aucune clé requise ici : la configuration se fait entièrement depuis
# l'espace rédaction → Sources. Cette section documente juste que le
# sous-système existe et où trouver sa configuration.
