# Exemple de configuration Nginx pour Kaloum24.
# À adapter puis placer dans /etc/nginx/sites-available/kaloum24
# puis : ln -s /etc/nginx/sites-available/kaloum24 /etc/nginx/sites-enabled/
#        nginx -t && systemctl reload nginx
#
# Certificat HTTPS : certbot --nginx -d tondomaine.com -d www.tondomaine.com

# Zone de limitation au niveau du serveur, en complément de celle de
# l'application : arrête les abus avant même qu'ils n'atteignent Python.
limit_req_zone $binary_remote_addr zone=kaloum_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=kaloum_ecriture:10m rate=2r/s;

server {
    listen 80;
    server_name tondomaine.com www.tondomaine.com;
    # Redirection vers HTTPS (certbot ajoute ce bloc automatiquement)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tondomaine.com www.tondomaine.com;

    ssl_certificate     /etc/letsencrypt/live/tondomaine.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tondomaine.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Doit rester au moins égal à MAX_CONTENT_LENGTH côté application (8 Mo),
    # sinon Nginx rejette l'envoi d'image avant que l'application ne réponde.
    client_max_body_size 10M;

    access_log /var/log/nginx/kaloum24.access.log;
    error_log  /var/log/nginx/kaloum24.error.log;

    # Compression : décisive sur connexion lente.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json
               application/rss+xml application/xml image/svg+xml;
    gzip_min_length 512;

    # Fichiers statiques servis directement par Nginx, sans passer par Python.
    location /static/ {
        alias /var/www/kaloum24/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Les images envoyées changent : cache plus court.
    location /static/uploads/ {
        alias /var/www/kaloum24/static/uploads/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    location = /sante {
        proxy_pass http://127.0.0.1:8000;
        access_log off;
    }

    # Points d'entrée sensibles : limite plus stricte.
    location ~ ^/(connexion|inscription|mot-de-passe-oublie) {
        limit_req zone=kaloum_ecriture burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=kaloum_general burst=50 nodelay;
        proxy_pass http://127.0.0.1:8000;

        # Ces en-têtes sont indispensables : c'est ce que lit ProxyFix côté
        # application pour connaître la vraie IP du visiteur (limitation de
        # débit) et le schéma réel (génération des URL en https).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
